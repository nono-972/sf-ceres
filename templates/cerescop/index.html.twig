{% extends 'base.html.twig' %}

{% block title %}Cerescop index{% endblock %}

{% block body %}
    <h1>Cerescop index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Image</th>
                <th>Video</th>
                <th>Nom</th>
                <th>Description</th>
                <th>Date</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for cerescop in cerescops %}
            <tr>
                <td>{{ cerescop.id }}</td>
                <td>{{ cerescop.image }}</td>
                <td>{{ cerescop.video }}</td>
                <td>{{ cerescop.nom }}</td>
                <td>{{ cerescop.description }}</td>
                <td>{{ cerescop.date ? cerescop.date|date('Y-m-d H:i:s') : '' }}</td>
                <td>
                    <a href="{{ path('app_cerescop_show', {'id': cerescop.id}) }}">show</a>
                    <a href="{{ path('app_cerescop_edit', {'id': cerescop.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_cerescop_new') }}">Create new</a>
{% endblock %}
