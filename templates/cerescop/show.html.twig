{% extends 'base.html.twig' %}

{% block title %}Cerescop{% endblock %}

{% block body %}
    <h1>Cerescop</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ cerescop.id }}</td>
            </tr>
            <tr>
                <th>Image</th>
                <td>{{ cerescop.image }}</td>
            </tr>
            <tr>
                <th>Video</th>
                <td>{{ cerescop.video }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ cerescop.nom }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ cerescop.description }}</td>
            </tr>
            <tr>
                <th>Date</th>
                <td>{{ cerescop.date ? cerescop.date|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_cerescop_index') }}">back to list</a>

    <a href="{{ path('app_cerescop_edit', {'id': cerescop.id}) }}">edit</a>

    {{ include('cerescop/_delete_form.html.twig') }}
