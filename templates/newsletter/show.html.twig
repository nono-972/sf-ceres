{% extends 'base.html.twig' %}

{% block title %}Newsletter{% endblock %}

{% block body %}
    <h1>Newsletter</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ newsletter.id }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ newsletter.nom }}</td>
            </tr>
            <tr>
                <th>Date</th>
                <td>{{ newsletter.date ? newsletter.date|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Titre</th>
                <td>{{ newsletter.titre }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ newsletter.description }}</td>
            </tr>
            <tr>
                <th>Image</th>
                <td>{{ newsletter.image }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_newsletter_index') }}">back to list</a>

    <a href="{{ path('app_newsletter_edit', {'id': newsletter.id}) }}">edit</a>

    {{ include('newsletter/_delete_form.html.twig') }}
{% endblock %}
